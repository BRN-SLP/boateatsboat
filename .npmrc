# Hoist node_modules (npm-style flat layout) so that transitive deps relied on
# by @netlify/plugin-nextjs (notably @netlify/blobs) are resolvable inside the
# serverless function bundle. Without this, the dynamic /game/[id] route
# crashes at runtime with: Runtime.ImportModuleError: Cannot find module '@netlify/blobs'.
node-linker=hoisted
